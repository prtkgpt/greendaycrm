// GreenDay CRM - Prisma Schema
// Production-ready schema for landscaping business management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION (Business Owners)
// ============================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  password           String
  companyName        String?
  slug               String?   @unique // URL-friendly company identifier (e.g., "greenscape-lawn")
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  logo               String?
  website            String?
  description        String?   @db.Text

  // Stripe
  stripeCustomerId   String?
  subscriptionId     String?
  subscriptionStatus String?   @default("trial") // trial, active, canceled, past_due
  subscriptionTier   String?   @default("starter") // starter, growth, pro
  trialEndsAt        DateTime?

  emailVerified      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  customers          Customer[]
  jobs               Job[]
  crews              Crew[]
  invoices           Invoice[]
  serviceTypes       ServiceType[]
  routes             Route[]

  @@index([email])
  @@index([slug])
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  email               String?
  phone               String?
  address             String
  city                String
  state               String
  zip                 String
  lat                 Float?
  lng                 Float?

  // Portal access
  portalPassword      String?   // Hashed password for customer portal
  portalEnabled       Boolean   @default(false)
  lastPortalLogin     DateTime?

  propertySize        String?
  gateCode            String?
  specialInstructions String?   @db.Text
  tags                String[]  @default([])

  status              String    @default("active") // active, inactive

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  jobs                Job[]
  invoices            Invoice[]
  photos              CustomerPhoto[]
  recurringBillings   RecurringBilling[]

  @@unique([userId, email]) // Email must be unique within a company
  @@index([userId])
  @@index([status])
  @@index([name])
}

model CustomerPhoto {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  url         String
  type        String   // before, after, property
  description String?
  uploadedAt  DateTime @default(now())

  @@index([customerId])
}

// ============================================
// CREWS (Team Members)
// ============================================

model Crew {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  email     String?
  color     String?  // for calendar display (hex color)
  pin       String?  // 4-6 digit PIN for crew app login
  role      String   @default("crew") // crew, foreman, manager
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobs      Job[]
  routes    Route[]

  @@index([userId])
  @@index([userId, pin]) // For crew login lookup
}

// ============================================
// JOBS
// ============================================

model Job {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  crewId          String?
  crew            Crew?     @relation(fields: [crewId], references: [id], onDelete: SetNull)
  serviceTypeId   String?
  serviceType     ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  routeId         String?
  route           Route?    @relation(fields: [routeId], references: [id], onDelete: SetNull)

  title           String
  description     String?   @db.Text

  scheduledDate   DateTime
  scheduledTime   String?   // "09:00"
  duration        Int?      // minutes

  status          String    @default("scheduled") // scheduled, in_progress, completed, canceled, weather_delay

  // Recurring
  isRecurring         Boolean   @default(false)
  recurrencePattern   String?   // weekly, biweekly, monthly
  recurrenceEndDate   DateTime?
  parentJobId         String?

  price           Float?
  routeOrder      Int?      // Order in route

  // Completion
  completedAt     DateTime?
  checkInTime     DateTime?
  checkOutTime    DateTime?
  checkInLat      Float?
  checkInLng      Float?
  notes           String?   @db.Text
  beforePhotos    String[]  @default([])
  afterPhotos     String[]  @default([])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  invoice         Invoice?

  @@index([userId])
  @@index([customerId])
  @@index([crewId])
  @@index([routeId])
  @@index([scheduledDate])
  @@index([status])
}

// ============================================
// ROUTES
// ============================================

model Route {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  crewId          String?
  crew            Crew?    @relation(fields: [crewId], references: [id], onDelete: SetNull)

  name            String?
  date            DateTime
  status          String   @default("planned") // planned, optimized, in_progress, completed

  // Starting point
  startAddress    String?
  startLat        Float?
  startLng        Float?

  // Optimization data
  optimizedOrder  Json?    // Array of job IDs in optimized order
  totalDistance   Float?   // miles
  totalDuration   Int?     // minutes
  estimatedDuration Int?   // minutes (alias for compatibility)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  jobs            Job[]

  @@index([userId])
  @@index([crewId])
  @@index([date])
}

// ============================================
// INVOICES
// ============================================

model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobId           String?   @unique
  job             Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // Line items stored as JSON
  lineItems       Json      @default("[]")

  subtotal        Float
  taxRate         Float?    @default(0)
  tax             Float?    @default(0)
  total           Float

  status          String    @default("draft") // draft, sent, paid, partial, overdue, canceled

  dueDate         DateTime?
  paidDate        DateTime?
  sentDate        DateTime?
  paidAmount      Float?    @default(0)
  paymentMethod   String?   // manual, stripe, cash, check

  // Stripe
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  stripePaymentUrl      String?

  notes           String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceNumber])
}

// ============================================
// RECURRING BILLING
// ============================================

model RecurringBilling {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  description   String
  amount        Float
  frequency     String    // weekly, biweekly, monthly
  startDate     DateTime
  endDate       DateTime?
  active        Boolean   @default(true)
  nextBillDate  DateTime

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
  @@index([nextBillDate])
}

// ============================================
// SERVICE TYPES
// ============================================

model ServiceType {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  defaultPrice      Float?
  duration          Int?     // minutes
  estimatedDuration Int?     // minutes (alias for compatibility)
  color             String?  // for calendar display
  isPublic          Boolean  @default(true) // Show on public booking page

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  jobs              Job[]

  @@index([userId])
}

// ============================================
// SERVICE REQUESTS (Customer Bookings)
// ============================================

model ServiceRequest {
  id              String    @id @default(cuid())
  userId          String    // The business owner
  customerId      String?   // Linked customer (if existing)
  serviceTypeId   String?

  // Contact info (for new customers)
  name            String
  email           String
  phone           String?
  address         String
  city            String
  state           String
  zip             String

  // Request details
  serviceType     String?   // Free text if no serviceTypeId
  preferredDate   DateTime?
  preferredTime   String?
  message         String?   @db.Text

  status          String    @default("pending") // pending, approved, declined, converted

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}
